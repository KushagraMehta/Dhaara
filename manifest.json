{
  "manifest_version": 3,
  "name": "Dhaara",
  "version": "0.2.0",
  "description": "Let your YouTube Mixes flow into Spotify: play, queue, like or save the songs you find on YouTube.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dhaara",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "https://developer.spotify.com/*",
    "https://*.chromiumapp.org/*",
    "https://open.spotify.com/*",
    "https://open.spotifycdn.com/*"
  ],
  "commands": {
    "like-current": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Like the song playing on YouTube"
    },
    "queue-current": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Queue the song playing on YouTube"
    },
    "save-mix": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this Mix to its Spotify playlist"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
